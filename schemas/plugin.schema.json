{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/run-bigpig/dsh-plugin-hub/blob/main/schemas/plugin.schema.json",
  "title": "DeepSeek Harness Marketplace plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "publisher", "packageName", "repository", "release", "compatibility", "permissions", "license", "verified"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 320 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "packageName": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "assetUrl", "sha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "assetUrl": { "type": "string", "pattern": "^https://github\\.com/.+/releases/download/.+\\.tgz$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnessCommits"],
      "properties": {
        "harnessCommits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["network", "filesystem-read", "filesystem-write", "subprocess", "credentials"] }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "verified": { "type": "boolean" }
  }
}
